# Backend Configuration

# API Settings
DEBUG=True

# Database Configuration
DATABASE_URL=postgresql://loan_app:password@localhost:5432/loan_approval

# LLM Configuration
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7

# Bias Detection Thresholds
BIAS_L1_ESCALATE_THRESHOLD=0.6
BIAS_L1_REVIEW_THRESHOLD=0.3
BIAS_L2_ESCALATE_THRESHOLD=0.7
BIAS_L2_REVIEW_THRESHOLD=0.5

# Gradient Boosting Model Configuration
GB_N_ESTIMATORS=100
GB_MAX_DEPTH=7
GB_LEARNING_RATE=0.1

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=noreply@loanapproval.com

# Model Paths
GB_MODEL_PATH=./ml/models/gb_model.pkl
SCALER_PATH=./ml/models/scaler.pkl
